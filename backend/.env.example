# ── Server ─────────────────────────────────────────────────────
PORT=3001

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key

# ── CORS ───────────────────────────────────────────────────────
# URL do frontend em produção (ex: https://seu-omnicore.vercel.app)
FRONTEND_URL=https://seu-omnicore.vercel.app

# ── Backend public URL (used for webhook registration) ─────────
# URL pública deste backend (ex: https://seu-backend.railway.app)
BACKEND_URL=https://seu-backend.railway.app

# ── Webhook Security ───────────────────────────────────────────
# Segredo compartilhado com a Evolution API para validar webhooks
# Configure o mesmo valor no painel da Evolution API
# Se não definido, a validação é ignorada (não recomendado em produção)
EVOLUTION_WEBHOOK_SECRET=seu_segredo_aqui
